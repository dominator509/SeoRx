# Copy this file to .env.production.local for local live smoke checks.
# Never commit real secrets. .env.production.local is ignored by Git.

# Core runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
SESSION_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_32_byte_base64_value
ALLOWED_ORIGINS=https://your-frontend.example.com
API_BASE_URL=https://your-api.example.com

# Optional frontend/API routing
BASE_PATH=/
VITE_CLERK_PROXY_URL=

# Optional Google integrations
PAGESPEED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Optional AI provider smoke credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional live smoke target for PageSpeed
LIVE_SMOKE_URL=https://example.com
